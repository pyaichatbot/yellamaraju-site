# Newsletter (Beehiiv)
# Find your publication_id in Beehiiv Dashboard → Settings → Integration → Embed
PUBLIC_BEEHIIV_FORM_ID=your-beehiiv-form-id

NEWSLETTER_AUTOMATION_SECRET=replace-with-random-secret

# LLM Mastery enrollment tracking
# Required to access the owner-only /api/enrollments endpoint.
# Set to any strong random string (e.g. openssl rand -hex 32).
# In Netlify Dashboard: Site Settings → Environment Variables → Add variable.
LLM_MASTERY_ENROLLMENT_SECRET=replace-with-random-secret
